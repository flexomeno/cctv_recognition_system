# El umbral, la zona, la duración y el movimiento no van aquí.
# Se guardan en dvr_chN/config/config.json desde el tablero de Kerberos.
# Si se ponen en este archivo, pisan lo que se guarde en el tablero.
AGENT_NAME=dvr_ch1
AGENT_TIMEZONE=America/Bogota
AGENT_OFFLINE=true
AGENT_USERNAME=agente
AGENT_PASSWORD=cambia-esto
AGENT_CAPTURE_IPCAMERA_RTSP=rtsp://usuario:clave@192.168.110.110:554/cam/realmonitor?channel=1&subtype=1
AGENT_AUTO_CLEAN=true
AGENT_AUTO_CLEAN_MAX_SIZE=400
AGENT_REMOVE_AFTER_UPLOAD=false
LOG_LEVEL=info
